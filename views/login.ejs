<!doctype html>
<html lang="en">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>

<section class="container section auth-section">
  <div class="auth-card">
    <h1>Sign In</h1>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>
    <form action="/login" method="POST">
      <input type="hidden" name="next" value="<%= next %>" />
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autofocus />
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required />
      <button type="submit" class="btn btn-full">Sign In</button>
    </form>
    <p class="auth-switch">No account? <a href="/register">Register here</a></p>
    <p class="hint small">Demo accounts: seller@containerbid.com / jane@example.com — password: password123</p>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
