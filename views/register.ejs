<!doctype html>
<html lang="en">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>

<section class="container section auth-section">
  <div class="auth-card">
    <h1>Create Account</h1>
    <% if (errors.length) { %>
      <ul class="form-error">
        <% errors.forEach(e => { %><li><%= e.msg %></li><% }) %>
      </ul>
    <% } %>
    <form action="/register" method="POST">
      <label for="name">Full Name</label>
      <input type="text" id="name" name="name" value="<%= form.name || '' %>" required autofocus />
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= form.email || '' %>" required />
      <label for="password">Password</label>
      <input type="password" id="password" name="password" minlength="6" required />
      <label for="role">I want to</label>
      <select id="role" name="role">
        <option value="bidder" <%= form.role === 'bidder' ? 'selected' : '' %>>Bid on sections</option>
        <option value="seller" <%= form.role === 'seller' ? 'selected' : '' %>>Sell sections</option>
        <option value="facility" <%= form.role === 'facility' ? 'selected' : '' %>>Manage a facility</option>
      </select>
      <button type="submit" class="btn btn-full">Create Account</button>
    </form>
    <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
