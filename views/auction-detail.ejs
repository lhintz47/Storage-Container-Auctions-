<!doctype html>
<html lang="en">
<%- include('partials/head') %>
<body>
<%- include('partials/nav') %>

<section class="container section auction-detail">
  <div class="detail-grid">
    <div class="detail-media">
      <%- include('partials/lot-image', { seed: auction.image_seed, label: auction.category }) %>
      <span class="badge badge-<%= auction.status %> badge-overlay">
        <%= auction.status === 'live' ? 'Live Auction' : (auction.status === 'sold' ? 'Sold' : 'Auction Ended') %>
      </span>
    </div>

    <div class="detail-info">
      <span class="eyebrow"><%= auction.category %> &middot; <%= auction.location %></span>
      <h1><%= auction.title %></h1>

      <dl class="spec-list">
        <div><dt>Facility</dt><dd><%= auction.facility %></dd></div>
        <div><dt>Container Code</dt><dd><%= auction.container_code %></dd></div>
        <div><dt>Section</dt><dd>#<%= auction.section_number %> of the container &mdash; <%= auction.section_size %></dd></div>
        <div><dt>Reserve</dt><dd><%= auction.reserve_price ? 'Reserve set' : 'No reserve' %></dd></div>
      </dl>

      <p class="description"><%= auction.description %></p>

      <div class="bid-panel">
        <div class="bid-panel-row">
          <div>
            <span class="label">Current Bid</span>
            <span class="price price-lg">$<%= auction.current_price.toLocaleString() %></span>
            <span class="bid-count"><%= auction.bid_count %> bid<%= auction.bid_count === 1 ? '' : 's' %></span>
          </div>
          <div class="countdown-box">
            <span class="label"><%= auction.status === 'live' ? 'Time Remaining' : 'Auction Closed' %></span>
            <div class="countdown countdown-lg" data-end="<%= auction.end_time %>" data-status="<%= auction.status %>">--</div>
          </div>
        </div>

        <% if (auction.status === 'live') { %>
          <% if (currentUser) { %>
            <% if (currentUser.id === auction.seller_id) { %>
              <p class="hint">You listed this section — you can't bid on your own auction.</p>
            <% } else { %>
              <form action="/auctions/<%= auction.id %>/bid" method="POST" class="bid-form">
                <label for="amount">Your bid (minimum $<%= minBid.toLocaleString() %>)</label>
                <div class="bid-form-row">
                  <span class="prefix">$</span>
                  <input type="number" id="amount" name="amount" min="<%= minBid %>" step="<%= auction.bid_increment %>" value="<%= minBid %>" required />
                  <button type="submit" class="btn btn-bid">Place Bid</button>
                </div>
              </form>
              <form action="/auctions/<%= auction.id %>/watch" method="POST">
                <button type="submit" class="link-btn watch-btn"><%= watching ? '★ Watching' : '☆ Add to Watchlist' %></button>
              </form>
            <% } %>
          <% } else { %>
            <p class="hint"><a href="/login?next=/auctions/<%= auction.id %>">Sign in</a> to place a bid on this section.</p>
          <% } %>
        <% } else if (auction.status === 'sold') { %>
          <p class="hint hint-sold">This section sold for $<%= auction.current_price.toLocaleString() %>.</p>
        <% } else { %>
          <p class="hint">This auction ended without meeting reserve.</p>
        <% } %>
      </div>
    </div>
  </div>

  <div class="bid-history">
    <h2 class="section-title">Bid History</h2>
    <% if (bidHistory.length === 0) { %>
      <p class="empty-state">No bids yet. Be the first.</p>
    <% } else { %>
      <table class="history-table">
        <thead><tr><th>Bidder</th><th>Amount</th><th>Time</th></tr></thead>
        <tbody>
          <% bidHistory.forEach((b, i) => { %>
            <tr class="<%= i === 0 ? 'top-bid' : '' %>">
              <td><%= b.bidder_name %><%= i === 0 ? ' 👑' : '' %></td>
              <td>$<%= b.amount.toLocaleString() %></td>
              <td><%= new Date(b.created_at + 'Z').toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
<script src="/js/countdown.js"></script>
</body>
</html>
